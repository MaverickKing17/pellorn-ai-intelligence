
# PELLORN — ENVIRONMENT TEMPLATE
# Example values only. Never commit real secrets.

# --- APP CONFIGURATION ---
NODE_ENV=development
VITE_APP_TITLE=Pellorn
VITE_API_BASE_URL=http://localhost:3000

# Optional. Label for the build environment (development | staging | production).
# If unset, the in-app diagnostics panel shows "Not configured".
VITE_APP_ENV=

# --- SUPABASE CLIENT CONFIGURATION ---
# Public client values; protect database access with RLS.
VITE_SUPABASE_URL=https://brinaukfmhgchfwdzgjs.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_your_supabase_publishable_key

# --- SERVER-SIDE AI SECURITY INTEGRATION ---
# Configure secrets only in the backend environment.
# Do not add secret API keys to VITE_ variables.
LAKERA_GUARD_API_KEY=

# --- MICROSOFT ENTRA ID ---
# Configure only after the app registration and redirect URI exist.
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_TENANT_ID=
VITE_AZURE_AD_REDIRECT_URI=

# --- MICROSOFT SENTINEL ---
# Configure only after the relevant Azure resources exist.
SENTINEL_WORKSPACE_ID=
SENTINEL_DCE_ENDPOINT=
SENTINEL_DCR_IMMUTABLE_ID=
SENTINEL_STREAM_NAME=

# --- TEST FLAGS ---
VITE_ENABLE_RED_TEAM_SANDBOX=true
VITE_ENABLE_LIVE_KILL_SWITCH=false
