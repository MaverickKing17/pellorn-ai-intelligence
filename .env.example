# =========================================================================
# BASTION AUDIT - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your actual keys.
# DO NOT commit .env.local to version control.
# =========================================================================

# --- APP CONFIGURATION ---
NODE_ENV=development
VITE_APP_TITLE=Bastion-Audit-Enterprise
VITE_API_BASE_URL=http://localhost:3000

# --- LAKERA GUARD (AI Security Layer) ---
# Get your key from: https://platform.lakera.ai/
VITE_LAKERA_GUARD_API_KEY=your_lakera_key_here

# --- MICROSOFT ENTRA ID (Identity & Access) ---
# Get these from Azure Portal -> App Registrations
VITE_AZURE_AD_CLIENT_ID=your_client_id_here
VITE_AZURE_AD_TENANT_ID=your_tenant_id_here
VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173

# --- MICROSOFT SENTINEL (Log Ingestion) ---
# For custom logging via Data Collection Rules (DCR)
VITE_SENTINEL_WORKSPACE_ID=your_workspace_id_here
VITE_SENTINEL_DCE_ENDPOINT=https://your-dce-endpoint.canada-central.ingest.monitor.azure.com
VITE_SENTINEL_DCR_IMMUTABLE_ID=dcr-your-immutable-id-here
VITE_SENTINEL_STREAM_NAME=Custom-BastionAudit_CL

# --- FEATURE FLAGS ---
VITE_ENABLE_RED_TEAM_SANDBOX=true
VITE_ENABLE_LIVE_KILL_SWITCH=true
